[Unit]
Description=my-place reader service
After=network.target

[Service]
User=pi
Group=pi
WorkingDirectory=/home/pi/my-place/reader-api
EnvironmentFile=/home/pi/my-place/.env
ExecStart=/home/pi/my-place/venv/bin/python -m uvicorn app.main:app \
    --host 0.0.0.0 \
    --port 8000 \
    --workers 1
Restart=always
RestartSec=5
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
